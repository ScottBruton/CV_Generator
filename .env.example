# Server-side only — never prefix with VITE_ and never commit real secrets.
OPEN_AI_API_KEY=
OPEN_AI_MODEL=gpt-5.6-sol

# Login gate (both required to enable). Set these in Render → Environment.
AUTH_USERNAME=
AUTH_PASSWORD=
SESSION_SECRET=

# Optional override for PDF headless print origin (defaults to same host in production).
# EXPORT_ORIGIN=https://scottbruton.net

# Optional Chrome/Chromium path for PDF export
# CHROME_PATH=
# PUPPETEER_EXECUTABLE_PATH=
# On Render, set PUPPETEER_CACHE_DIR=/opt/render/project/src/.cache/puppeteer
# PUPPETEER_CACHE_DIR=

# Persist live-site content edits to GitHub (Render). Required for variants
# created on the website to survive redeploys / free-tier spin-down.
# Create a fine-grained PAT with Contents: Read and write on this repo.
# GITHUB_TOKEN=
# GITHUB_REPO=ScottBruton/CV_Generator
# GITHUB_BRANCH=main
# CONTENT_SYNC_ENABLED=true
